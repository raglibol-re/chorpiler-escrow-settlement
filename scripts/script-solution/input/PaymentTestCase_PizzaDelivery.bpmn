      <bpmn2:outgoing>SequenceFlow_0dy5er9</bpmn2:outgoing>
    </bpmn2:startEvent>
    <!-- RE: add settlement LOCK -->
    <bpmn2:choreographyTask id="ChoreographyTask_0hy9n0g" name="order and pay 15 USDC for pizza" initiatingParticipantRef="Participant_06qakjv">
      <bpmn2:extensionElements>
      <chorpiler:settlement
          op="LOCK"
          tokenRef="USDC"
          amount="15000000"
          payerRef="Participant_06qakjv"
