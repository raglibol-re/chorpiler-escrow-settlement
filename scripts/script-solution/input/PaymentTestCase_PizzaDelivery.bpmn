    <bpmn2:choreographyTask id="ChoreographyTask_175oxwe" name="deliver pizza" initiatingParticipantRef="Participant_0537iz2">
      <bpmn2:incoming>SequenceFlow_0esuuaj</bpmn2:incoming>
