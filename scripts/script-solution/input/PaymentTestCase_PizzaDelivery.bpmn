        <!-- RE: add settlement -->
    <bpmn2:choreographyTask id="ChoreographyTask_0wgwx5w" name="Confirm delivery and releas payment" initiatingParticipantRef="Participant_06qakjv">
            <bpmn2:extensionElements>
      <chorpiler:settlement
          op="RELEASE"
          tokenRef="USDC"
          amount="15000000"
          payerRef="Participant_06qakjv"
          payeeRef="Participant_0mgz9si"
          escrowKey="pizza_payment"
        />
        </bpmn2:extensionElements>
      <bpmn2:extensionElements>
